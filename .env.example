# SREE Assistant Environment Configuration
APP_NAME=SREE
APP_ENV=development
HOST=0.0.0.0
PORT=8005

# AI Engine (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.2:3b
FALLBACK_MODEL=llama3.2:1b

# Security (Set strong token for production/mobile access)
AUTH_TOKEN=sree-local-secure-key-2026
ALLOW_LAN_ACCESS=true

# Storage
DATABASE_PATH=data/database/sree.db

